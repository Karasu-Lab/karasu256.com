{
  "build": {
    "env": {
      "ENABLE_EXPERIMENTAL_COREPACK": "1"
    }
  },
  "buildCommand": "pnpm build",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "dev": true,
      "main": true
    }
  },
  "installCommand": "printf '//npm.pkg.github.com/:_authToken=%s\\n' \"$NODE_AUTH_TOKEN\" >> \"$HOME/.npmrc\" && pnpm install --no-frozen-lockfile"
}
